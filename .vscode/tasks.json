{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Debug)",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (Release)",
      "type": "shell",
      "command": "cmake --build --preset release",
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "cmake --build --preset debug --target fx-core-tests && ctest --preset debug",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Validate plugin (pluginval)",
      "type": "shell",
      "command": "${workspaceFolder}/tools/validate.sh",
      "args": ["debug"],
      "dependsOn": "Build (Debug)",
      "problemMatcher": []
    }
  ]
}
